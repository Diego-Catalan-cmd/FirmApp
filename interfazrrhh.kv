#:kivy 2.3.1
# archivo: interfazrrhh.kv
# ---------------------------------------------------------------------------
# Sesion 12 - "KV Language y la separacion de la logica".
# Este archivo es la capa de DISENO/UI. No contiene logica de negocio:
# solo estructura visual, colores y tamanos. Se carga solo porque la clase
# de la app se llama InterfazRRHHApp (ver "Magia pura: la carga automatica").
# ---------------------------------------------------------------------------
#:import T theme
#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp
#:import S solicitudes


# ============================================================ CLASES DINAMICAS
# Dos variantes de MDLabel (el componente de texto de KivyMD).
# theme_text_color: 'Custom' desactiva el color automatico del tema Material
# para poder usar los colores exactos del diseno de Figma.

# Bloque de texto que ajusta su alto al contenido.
<Txt@MDLabel>:
    font_name: T.FONT
    theme_text_color: 'Custom'
    text_color: T.C_TEXT
    # Sin esto, un MDLabel dentro de un widget deshabilitado se pinta con
    # disabled_color del tema Material y pierde el color del diseno.
    disabled_color: self.text_color
    size_hint_y: None
    text_size: self.width, None
    height: self.texture_size[1] if self.text else dp(1)
    halign: 'left'
    valign: 'top'


# Etiqueta centrada, para textos de una sola linea.
# Las que deben medir exactamente lo que mide su texto agregan
# "adaptive_width: True", la propiedad de KivyMD para ese ajuste.
<TxtFijo@MDLabel>:
    font_name: T.FONT
    theme_text_color: 'Custom'
    text_color: T.C_TEXT
    disabled_color: self.text_color
    halign: 'center'
    valign: 'middle'


# ============================================================== TARJETA GLASS
# Valores por defecto del efecto "vidrio" del diseno de Figma.
# El relleno, el borde y el radio los pinta KivyMD (md_bg_color, line_color,
# line_width, radius); la sombra difusa la agrega GlassCard en widgets.py.
# Esta regla tambien alcanza a sus subclases: StatCard, QuickActionCard,
# HeaderCard, PendingCard, FooterCard, SignPanel...
<GlassCard>:
    md_bg_color: T.C_GLASS
    line_color: T.C_GLASS_BORDER
    line_width: 1.1
    radius: dp(24)


# =================================================================== PILDORA
<Pill>:
    size_hint: None, None
    height: dp(21)
    radius: self.height / 2
    padding: dp(10), 0
    spacing: dp(4)
    width: (icn.width if root.icon_name else 0) + lbl.texture_size[0] + dp(20)
    Icon:
        id: icn
        name: root.icon_name
        color: root.fg_color
        size_hint: None, None
        size: (dp(12), dp(12)) if root.icon_name else (0, 0)
        pos_hint: {'center_y': .5}
    TxtFijo:
        id: lbl
        text: root.text
        font_name: T.FONT
        font_size: sp(10.5)
        bold: True
        text_color: root.fg_color
        adaptive_width: True
        size_hint_y: 1


# =============================================================== ICON TILE
# El fondo y el radio los pinta KivyMD con md_bg_color / radius; dentro solo
# va el icono vectorial del diseno.
<IconTile>:
    Icon:
        name: root.icon_name
        color: root.icon_color
        size_hint: None, None
        size: self.parent.width * 0.46, self.parent.height * 0.46
        pos_hint: {'center_x': .5, 'center_y': .5}


<IconButton>:
    Icon:
        name: root.icon_name
        color: root.icon_color
        size_hint: None, None
        size: self.parent.width * 0.48, self.parent.height * 0.48
        pos_hint: {'center_x': .5, 'center_y': .5}


# ==================================================================== BOTON
<SolidButton>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(44)
    radius: dp(16)
    spacing: dp(8)
    MDWidget:
    Icon:
        name: root.icon_name
        color: root.fg_color
        size_hint: None, 1
        width: dp(17) if root.icon_name else 0
        pos_hint: {'center_y': .5}
    TxtFijo:
        text: root.text
        font_name: T.FONT
        font_size: sp(13)
        bold: True
        text_color: root.fg_color
        adaptive_width: True
        size_hint_y: 1
    MDWidget:


# =============================================================== ESTADISTICA
<StatCard>:
    orientation: 'vertical'
    radius: dp(16)
    padding: dp(4), dp(10)
    spacing: dp(1)
    MDWidget:
    Txt:
        text: root.value
        font_size: sp(19)
        bold: True
        text_color: T.C_PRIMARY
        halign: 'center'
    Txt:
        text: root.sub
        font_size: sp(9.5)
        text_color: T.C_SECONDARY
        halign: 'center'
    MDWidget:


# ============================================================ ACCION RAPIDA
<QuickActionCard>:
    orientation: 'vertical'
    radius: dp(22)
    padding: dp(12), dp(13)
    spacing: dp(6)
    MDFloatLayout:
        size_hint: None, None
        size: dp(44), dp(44)
        GradientTile:
            pos_hint: {'x': 0, 'y': 0}
            size_hint: 1, 1
            tile_radius: dp(15)
            c1: root.c1
            c2: root.c2
        Icon:
            name: root.icon_name
            color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(24), dp(24)
            pos_hint: {'center_x': .5, 'center_y': .5}
    Txt:
        text: root.label_text
        font_size: sp(11.5)
        bold: True
        text_color: T.C_TEXT
    Txt:
        text: root.sub_text
        font_size: sp(9.5)
        text_color: T.C_SECONDARY
    MDWidget:


# ============================================================ SECCION LABEL
<SectionLabel>:
    size_hint_y: None
    height: dp(24)
    padding: dp(4), 0
    spacing: dp(6)
    TxtFijo:
        text: root.title
        font_name: T.FONT
        font_size: sp(11.5)
        bold: True
        text_color: T.C_TEXT
        adaptive_width: True
    MDWidget:
    MDFloatLayout:
        size_hint: None, None
        size: (dp(20), dp(20)) if root.count >= 0 else (0, 0)
        opacity: 1 if root.count >= 0 else 0
        MDBoxLayout:
            pos_hint: {'x': 0, 'y': 0}
            size_hint: 1, 1
            md_bg_color: T.C_TINT_10
            radius: dp(10)
        TxtFijo:
            text: str(root.count)
            font_name: T.FONT
            font_size: sp(10)
            bold: True
            text_color: T.C_PRIMARY
            pos_hint: {'center_x': .5, 'center_y': .5}


# =================================================================== HEADER
<HeaderCard>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(92)
    radius: dp(24)
    padding: dp(18), dp(14)
    spacing: dp(10)
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(2)
        MDWidget:
        Txt:
            text: root.greeting
            font_size: sp(11)
            bold: True
            text_color: T.C_SECONDARY
        Txt:
            text: 'Valentina Soto'
            font_size: sp(17.5)
            bold: True
            text_color: T.C_TEXT
        Txt:
            text: 'Área Comercial · Jornada Completa'
            font_size: sp(10.5)
            text_color: T.C_SECONDARY
        MDWidget:
    MDBoxLayout:
        size_hint_x: None
        width: dp(92)
        spacing: dp(10)
        MDFloatLayout:
            size_hint_x: None
            width: dp(40)
            IconButton:
                icon_name: 'bell'
                icon_color: T.C_PRIMARY
                md_bg_color: T.C_TINT_10
                radius: dp(13)
                size_hint: None, None
                size: dp(40), dp(40)
                pos_hint: {'x': 0, 'center_y': .5}
                on_release: app.show_notifications()
            Dot:
                opacity: 1 if root.has_alerts else 0
                color: T.rgba(T.ORANGE_DOT)
                ring: True
                size_hint: None, None
                size: dp(9), dp(9)
                pos_hint: {'center_x': .76, 'center_y': .78}
        MDFloatLayout:
            size_hint_x: None
            width: dp(40)
            GradientTile:
                size_hint: None, None
                size: dp(40), dp(40)
                tile_radius: dp(13)
                c1: T.C_PRIMARY
                c2: T.C_PRIMARY_DARK
                pos_hint: {'x': 0, 'center_y': .5}
                TxtFijo:
                    text: 'VS'
                    font_name: T.FONT
                    bold: True
                    font_size: sp(13)
                    text_color: 1, 1, 1, 1
                    pos_hint: {'center_x': .5, 'center_y': .5}


# ============================================================ TAREA PENDIENTE
<PendingCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    radius: dp(22)
    padding: dp(16)
    spacing: dp(12)
    MDBoxLayout:
        size_hint_y: None
        height: dp(76)
        spacing: dp(10)
        MDBoxLayout:
            orientation: 'vertical'
            spacing: dp(4)
            MDBoxLayout:
                size_hint_y: None
                height: dp(21)
                spacing: dp(6)
                Pill:
                    text: root.doc_type
                    fg_color: T.C_PRIMARY
                    md_bg_color: T.C_TINT_10
                MDBoxLayout:
                    size_hint_x: None
                    width: (urgent_pill.width + dp(6)) if root.urgent else 0
                    opacity: 1 if root.urgent else 0
                    Pill:
                        id: urgent_pill
                        text: 'Urgente'
                        fg_color: T.rgba(T.ORANGE)
                        md_bg_color: T.rgba(T.ORANGE_BG)
                MDWidget:
            Txt:
                text: root.title
                font_size: sp(12.5)
                bold: True
                text_color: T.C_TEXT
            Txt:
                text: 'Vence: %s · %s páginas' % (root.deadline, root.pages)
                font_size: sp(10)
                text_color: T.C_SECONDARY
        IconTile:
            size_hint: None, None
            size: dp(40), dp(40)
            icon_name: 'file'
            icon_color: T.C_PRIMARY
            md_bg_color: T.C_BG
            radius: dp(14)
    SolidButton:
        text: 'Firmar con 1 toque'
        icon_name: 'pen'
        md_bg_color: T.C_PRIMARY
        fg_color: 1, 1, 1, 1
        height: dp(44)
        radius: dp(16)
        on_release: root.sign_pressed()


# =================================================================== FILA DOC
<DocRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(55)
    padding: dp(6), dp(8)
    spacing: dp(10)
    radius: dp(12)
    md_bg_color: 0, 0, 0, 0
    IconTile:
        size_hint: None, None
        size: dp(34), dp(34)
        icon_name: 'file'
        icon_color: T.C_PRIMARY
        md_bg_color: T.C_TINT_10
        radius: dp(11)
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(2)
        MDWidget:
        Txt:
            text: root.name
            font_size: sp(12)
            bold: True
            text_color: T.C_TEXT
        Txt:
            text: '%s · %s' % (root.date, root.filesize)
            font_size: sp(10)
            text_color: T.C_SECONDARY
        MDWidget:
    MDBoxLayout:
        size_hint_x: None
        width: dp(74)
        spacing: dp(6)
        MDBoxLayout:
            size_hint_x: None
            width: offline_pill.width if root.offline else 0
            opacity: 1 if root.offline else 0
            Pill:
                id: offline_pill
                icon_name: 'check'
                text: ''
                fg_color: T.rgba(T.EMERALD)
                md_bg_color: T.rgba(T.EMERALD_BG)
                line_color: T.rgba(T.EMERALD_BORDER, .7)
                line_width: 1.4
        Icon:
            name: 'chevron'
            color: T.C_SECONDARY
            size_hint: None, None
            size: dp(15), dp(15)
            pos_hint: {'center_y': .5}
    Divider:
        pos_hint: {'x': 0, 'y': 0}
        size_hint: 1, None
        height: dp(1)
        opacity: 0 if root.last else 1
        color: T.C_DIVIDER


# =============================================================== BARRA INFERIOR
<FooterCard>:
    orientation: 'horizontal'
    radius: dp(18)
    padding: dp(14), dp(10)
    spacing: dp(10)
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(2)
        MDWidget:
        Txt:
            text: 'Firma sin iniciar sesión'
            font_size: sp(11.5)
            bold: True
            text_color: T.C_TEXT
        Txt:
            text: 'Solo necesitas tu RUT'
            font_size: sp(9.5)
            text_color: T.C_SECONDARY
        MDWidget:
    SolidButton:
        text: 'Firmar'
        icon_name: 'pen'
        md_bg_color: T.C_PRIMARY
        fg_color: 1, 1, 1, 1
        size_hint_x: None
        width: dp(104)
        height: dp(40)
        radius: dp(13)
        on_release: root.sign_pressed()


# =========================================================== CTA ESCRITORIO
<DesktopCtaCard>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(84)
    radius: dp(22)
    padding: dp(16)
    spacing: dp(10)
    md_bg_color: T.C_GLASS_DARK
    line_color: 1, 1, 1, 0.28
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(2)
        MDWidget:
        Txt:
            text: '¿No iniciaste sesión?'
            font_size: sp(12.5)
            bold: True
            text_color: T.C_TEXT
        Txt:
            text: 'Puedes firmar documentos ingresando solo tu RUT'
            font_size: sp(10)
            text_color: T.C_SECONDARY
        MDWidget:
    SolidButton:
        text: 'Firmar sin sesión'
        icon_name: 'pen'
        md_bg_color: T.C_PRIMARY
        fg_color: 1, 1, 1, 1
        size_hint_x: None
        width: dp(150)
        height: dp(44)
        radius: dp(15)
        on_release: root.sign_pressed()


# ================================================== CONTENIDO PESTAÑA: RUT
<RutTabContent@MDBoxLayout>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(6)
    Txt:
        text: 'RUT DEL TRABAJADOR'
        font_size: sp(9.5)
        bold: True
        text_color: T.C_SECONDARY
    MDFloatLayout:
        size_hint_y: None
        height: dp(62)
        MDBoxLayout:
            id: field
            pos_hint: {'x': 0, 'y': 0}
            size_hint: 1, 1
            md_bg_color: 1, 1, 1, .7
            line_color: T.C_BG
            line_width: 1.8
            radius: dp(16)
            padding: dp(12), dp(4)
            MDFloatLayout:
                # Marcador de posicion propio: MDTextField sube su hint_text
                # al borde al escribir (animacion Material), y el diseno de
                # Figma lo muestra centrado y fijo. Por eso el hint va aparte.
                TxtFijo:
                    text: '12.345.678-9'
                    font_name: T.FONT_MONO
                    font_size: sp(21)
                    text_color: T.rgba(T.SECONDARY, .5)
                    opacity: 0 if rut_input.text else 1
                    pos_hint: {'x': 0, 'y': 0}
                    size_hint: 1, 1
                RutInput:
                    id: rut_input
                    pos_hint: {'x': 0, 'y': 0}
                    size_hint: 1, 1
                    # Se apagan los adornos de Material Design (subrayado,
                    # relleno y borde) para respetar el recuadro redondeado
                    # del diseno. El modo 'round' es el unico que no dibuja
                    # la linea inferior caracteristica de Material.
                    mode: 'round'
                    line_color_normal: 0, 0, 0, 0
                    line_color_focus: 0, 0, 0, 0
                    fill_color_normal: 0, 0, 0, 0
                    fill_color_focus: 0, 0, 0, 0
                    foreground_color: T.C_TEXT
                    text_color_normal: T.C_TEXT
                    text_color_focus: T.C_TEXT
                    cursor_color: T.C_PRIMARY
                    font_name: T.FONT_MONO
                    font_size: sp(21)
                    multiline: False
                    halign: 'center'
                    padding: dp(12), dp(16)
        MDFloatLayout:
            id: check
            opacity: 0
            size_hint: None, None
            size: dp(26), dp(26)
            pos_hint: {'right': .94, 'center_y': .5}
            Dot:
                color: T.C_PRIMARY
                pos_hint: {'x': 0, 'y': 0}
                size_hint: 1, 1
            Icon:
                name: 'check'
                color: 1, 1, 1, 1
                size_hint: None, None
                size: dp(14), dp(14)
                pos_hint: {'center_x': .5, 'center_y': .5}
    Txt:
        text: 'Ingresa tu RUT para verificar tu identidad'
        font_size: sp(9.5)
        text_color: T.C_SECONDARY
        halign: 'center'
        text_size: self.width, None


# =============================================== CONTENIDO PESTAÑA: DIBUJAR
<DrawTabContent@MDBoxLayout>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(6)
    MDBoxLayout:
        size_hint_y: None
        height: dp(20)
        Txt:
            text: 'DIBUJA TU FIRMA AQUÍ'
            font_size: sp(9.5)
            bold: True
            text_color: T.C_SECONDARY
        MDWidget:
        SolidButton:
            id: clear_btn
            text: 'Limpiar'
            icon_name: 'trash'
            md_bg_color: 0, 0, 0, 0
            fg_color: T.C_SECONDARY
            size_hint_x: None
            width: dp(80)
            height: dp(20)
            radius: dp(8)
            opacity: 0
            disabled: True
    DashedPanel:
        # MDBoxLayout con borde punteado: KivyMD pinta el relleno con
        # md_bg_color y el punteado lo agrega DashedPanel (widgets.py),
        # porque line_color de Material solo traza lineas continuas.
        size_hint_y: None
        height: dp(150)
        md_bg_color: 1, 1, 1, .6
        dash_color: T.rgba(T.PRIMARY, .35)
        dash_width: 1.6
        radius: dp(16)
        MDFloatLayout:
            SignaturePad:
                id: pad
                pos_hint: {'x': 0, 'y': 0}
                size_hint: 1, 1
            MDBoxLayout:
                id: hint
                orientation: 'vertical'
                spacing: dp(4)
                size_hint: 1, None
                height: dp(46)
                pos_hint: {'center_x': .5, 'center_y': .5}
                MDWidget:
                MDAnchorLayout:
                    anchor_x: 'center'
                    size_hint_y: None
                    height: dp(22)
                    Icon:
                        name: 'pen'
                        color: T.rgba(T.SECONDARY, .8)
                        size_hint: None, None
                        size: dp(22), dp(22)
                Txt:
                    text: 'Traza tu firma en este espacio'
                    font_size: sp(9.5)
                    text_color: T.C_SECONDARY
                    halign: 'center'
                    text_size: self.width, None
                MDWidget:
    MDBoxLayout:
        size_hint_y: None
        height: dp(14)
        spacing: dp(6)
        Divider:
            size_hint_y: None
            height: dp(1)
            pos_hint: {'center_y': .5}
        Txt:
            text: 'firma con valor legal'
            font_size: sp(8.5)
            text_color: T.C_SECONDARY
            halign: 'center'
            size_hint_x: None
            width: dp(110)
        Divider:
            size_hint_y: None
            height: dp(1)
            pos_hint: {'center_y': .5}


# ============================================================ TARJETA DE FIRMA
# SignPanel es el "cascaron" de la pantalla de firma (encabezado, pestañas,
# contenido, boton CTA, disclaimer). Vive DENTRO de SignScreen (una pantalla
# real del ScreenManager) en vez de flotar sobre un overlay oscuro: por eso
# ya no necesita separar 'chrome' (cascaron) de 'body' (pantalla de exito)
# como en la version con modal -- ese cambio de estado ahora es una
# transicion real de pantalla (ver SuccessScreen mas abajo).
<SignPanel>:
    orientation: 'vertical'
    size_hint: None, None
    width: dp(348)
    radius: dp(26)
    md_bg_color: T.C_GLASS_MODAL
    shadow_strength: 2.6
    padding: dp(20), dp(18)
    spacing: dp(12)
    MDBoxLayout:
        size_hint_y: None
        height: dp(76)
        spacing: dp(8)
        MDBoxLayout:
            orientation: 'vertical'
            spacing: dp(4)
            MDBoxLayout:
                size_hint_y: None
                height: dp(21)
                Pill:
                    text: root.doc_type
                    fg_color: T.C_PRIMARY
                    md_bg_color: T.C_TINT_10
                MDWidget:
            Txt:
                text: root.title
                font_size: sp(13)
                bold: True
                text_color: T.C_TEXT
            Txt:
                text: '%s páginas · Vence %s' % (root.pages, root.deadline)
                font_size: sp(10)
                text_color: T.C_SECONDARY
        IconButton:
            icon_name: 'close'
            icon_color: T.C_SECONDARY
            md_bg_color: 0, 0, 0, 0
            radius: dp(10)
            size_hint: None, None
            size: dp(32), dp(32)
            pos_hint: {'top': 1}
            on_release: root.close()
    MDBoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: dp(42)
        md_bg_color: T.rgba(T.BG, .6)
        radius: dp(15)
        padding: dp(4)
        spacing: dp(4)
        SolidButton:
            id: tab_rut
            text: 'Ingresar RUT'
            md_bg_color: 1, 1, 1, 1
            fg_color: T.C_PRIMARY
            height: dp(34)
            radius: dp(12)
            on_release: root.set_tab('rut')
        SolidButton:
            id: tab_draw
            text: 'Dibujar Firma'
            md_bg_color: 1, 1, 1, 0
            fg_color: T.C_SECONDARY
            height: dp(34)
            radius: dp(12)
            on_release: root.set_tab('draw')
    MDBoxLayout:
        id: content
        size_hint_y: None
        height: self.minimum_height
    SolidButton:
        id: cta
        text: 'Firmar con 1 toque'
        icon_name: 'pen'
        md_bg_color: T.C_PRIMARY
        fg_color: 1, 1, 1, 1
        height: dp(50)
        radius: dp(17)
        on_release: root.sign()
    Txt:
        text: 'Al firmar aceptas los términos del documento. Tu firma tiene validez legal.'
        font_size: sp(9)
        text_color: T.C_SECONDARY
        halign: 'center'
        text_size: self.width, None


# ============================================================ PANTALLAS
# Las 4 pantallas navegables del ScreenManager (ver InterfazRRHHApp.build()
# en main.py). Cada <XScreen>: es una regla de Kivy Language normal; lo unico
# que cambia frente a un widget cualquiera es que hereda de kivy.uix.
# screenmanager.Screen, asi que el ScreenManager puede mostrarla/ocultarla
# con una transicion animada al cambiar 'sm.current'.

# -------------------------------------------------------------------- LOGIN
# Primera pantalla que ve el usuario. El campo unico (LoginIdentifierInput,
# widgets.py) acepta RUT o correo y se autodetecta por si tiene '@'; la
# validacion real (digito verificador del RUT, forma del correo) vive en
# validators.py, no aqui ni en main.py -- este .kv solo pinta el resultado
# (check verde cuando es valido, boton habilitado cuando ambos campos lo
# son). Mismo lenguaje visual que el resto de la app: GlassCard sobre
# MeshBackground, recuadros redondeados propios en vez de los de Material
# (igual que el campo de RUT de SignPanel).
<LoginScreen>:
    MeshBackground:
        MDAnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            GlassCard:
                orientation: 'vertical'
                size_hint: None, None
                width: dp(336)
                height: self.minimum_height
                radius: dp(28)
                md_bg_color: T.C_GLASS_MODAL
                shadow_strength: 2.6
                padding: dp(26), dp(28)
                spacing: dp(14)
                MDAnchorLayout:
                    anchor_x: 'center'
                    size_hint_y: None
                    height: dp(64)
                    GradientTile:
                        size_hint: None, None
                        size: dp(64), dp(64)
                        tile_radius: dp(20)
                        c1: T.C_PRIMARY
                        c2: T.C_PRIMARY_DARK
                        Icon:
                            name: 'pen'
                            color: 1, 1, 1, 1
                            size_hint: None, None
                            size: dp(28), dp(28)
                            pos_hint: {'center_x': .5, 'center_y': .5}
                Txt:
                    text: 'FirmApp'
                    font_size: sp(19)
                    bold: True
                    text_color: T.C_TEXT
                    halign: 'center'
                    text_size: self.width, None
                Txt:
                    text: 'Firma tus documentos de RR.HH. desde el celular'
                    font_size: sp(10.5)
                    text_color: T.C_SECONDARY
                    halign: 'center'
                    text_size: self.width, None

                Txt:
                    text: 'RUT O CORREO'
                    font_size: sp(9.5)
                    bold: True
                    text_color: T.C_SECONDARY
                MDFloatLayout:
                    size_hint_y: None
                    height: dp(58)
                    MDBoxLayout:
                        pos_hint: {'x': 0, 'y': 0}
                        size_hint: 1, 1
                        md_bg_color: 1, 1, 1, .7
                        line_color: T.rgba(T.PRIMARY, 1) if identifier.valid else T.C_BG
                        line_width: 1.8
                        radius: dp(14)
                        padding: dp(6), dp(4)
                        MDFloatLayout:
                            # Envoltorio clave: dentro de un MDBoxLayout (la
                            # caja de arriba) dos hijos se reparten el ancho
                            # en vez de superponerse -- por eso el campo real
                            # solo ocupaba la mitad derecha. Un MDFloatLayout
                            # SI permite superponer el placeholder y el campo
                            # (mismo patron que el campo de RUT en Firmar).
                            TxtFijo:
                                text: 'RUT o correo'
                                font_name: T.FONT
                                font_size: sp(13)
                                text_color: T.rgba(T.SECONDARY, .55)
                                opacity: 0 if identifier.text else 1
                                halign: 'left'
                                valign: 'middle'
                                pos_hint: {'x': 0, 'y': 0}
                                size_hint: 1, 1
                                padding: dp(16), 0
                                text_size: self.width, None
                            LoginIdentifierInput:
                                id: identifier
                                pos_hint: {'x': 0, 'y': 0}
                                size_hint: 1, 1
                                mode: 'round'
                                line_color_normal: 0, 0, 0, 0
                                line_color_focus: 0, 0, 0, 0
                                fill_color_normal: 0, 0, 0, 0
                                fill_color_focus: 0, 0, 0, 0
                                foreground_color: T.C_TEXT
                                text_color_normal: T.C_TEXT
                                text_color_focus: T.C_TEXT
                                cursor_color: T.C_PRIMARY
                                font_name: T.FONT
                                font_size: sp(16)
                                multiline: False
                                halign: 'left'
                                padding: dp(16), dp(17)
                                on_id_valid: root.set_id_valid(args[1])
                    MDFloatLayout:
                        id: id_check
                        opacity: 1 if (identifier.text and identifier.valid) else 0
                        size_hint: None, None
                        size: dp(22), dp(22)
                        pos_hint: {'right': .95, 'center_y': .5}
                        Dot:
                            color: T.C_PRIMARY
                            pos_hint: {'x': 0, 'y': 0}
                            size_hint: 1, 1
                        Icon:
                            name: 'check'
                            color: 1, 1, 1, 1
                            size_hint: None, None
                            size: dp(12), dp(12)
                            pos_hint: {'center_x': .5, 'center_y': .5}
                Txt:
                    text: (('RUT válido' if identifier.valid else 'RUT inválido: revisa el dígito verificador') if identifier.kind == 'rut' else (('Correo válido' if identifier.valid else 'Formato de correo inválido') if identifier.kind == 'email' else ' '))
                    font_size: sp(9)
                    text_color: T.C_PRIMARY if identifier.valid else T.rgba(T.ORANGE, .9)
                    opacity: 1 if identifier.text else 0
                    halign: 'left'

                Txt:
                    text: 'CONTRASEÑA'
                    font_size: sp(9.5)
                    bold: True
                    text_color: T.C_SECONDARY
                MDFloatLayout:
                    size_hint_y: None
                    height: dp(58)
                    MDBoxLayout:
                        pos_hint: {'x': 0, 'y': 0}
                        size_hint: 1, 1
                        md_bg_color: 1, 1, 1, .7
                        line_color: T.C_BG
                        line_width: 1.8
                        radius: dp(14)
                        padding: dp(6), dp(4)
                        PasswordInput:
                            id: password
                            pos_hint: {'x': 0, 'y': 0}
                            size_hint: 1, 1
                            password: True
                            password_mask: u'•'
                            mode: 'round'
                            line_color_normal: 0, 0, 0, 0
                            line_color_focus: 0, 0, 0, 0
                            fill_color_normal: 0, 0, 0, 0
                            fill_color_focus: 0, 0, 0, 0
                            foreground_color: T.C_TEXT
                            text_color_normal: T.C_TEXT
                            text_color_focus: T.C_TEXT
                            cursor_color: T.C_PRIMARY
                            font_name: T.FONT
                            font_size: sp(22)
                            multiline: False
                            halign: 'left'
                            padding: dp(16), dp(14)
                            on_text: root.set_password_filled(self.text)

                Txt:
                    id: auth_feedback
                    text: ''
                    font_size: sp(9.5)
                    bold: True
                    text_color: T.rgba(T.ORANGE, .95)
                    halign: 'center'
                    text_size: self.width, None
                    opacity: 1 if self.text else 0
                    height: self.texture_size[1] if self.text else 0

                SolidButton:
                    id: cta
                    text: 'Ingresar'
                    icon_name: 'chevron'
                    md_bg_color: T.C_PRIMARY
                    fg_color: 1, 1, 1, 1
                    height: dp(50)
                    radius: dp(17)
                    on_release: root.login()

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(18)
                    spacing: dp(4)
                    MDWidget:
                    TxtFijo:
                        text: '¿No tienes cuenta?'
                        font_name: T.FONT
                        font_size: sp(10)
                        text_color: T.C_SECONDARY
                        adaptive_width: True
                    PressableBox:
                        size_hint: None, None
                        size: lbl_registro.texture_size[0] + dp(4), dp(18)
                        on_release: app.go_to_register()
                        TxtFijo:
                            id: lbl_registro
                            text: 'Regístrate'
                            font_name: T.FONT
                            font_size: sp(10)
                            bold: True
                            text_color: T.C_PRIMARY
                            adaptive_width: True
                            pos_hint: {'center_x': .5, 'center_y': .5}
                    MDWidget:
                Txt:
                    text: 'Cuenta de prueba: demo@firmapp.cl / demo1234'
                    font_size: sp(8.3)
                    text_color: T.C_SECONDARY
                    halign: 'center'
                    text_size: self.width, None


# =============================================================== REGISTRO
# Mismo "cascaron" visual que LoginScreen (misma tarjeta, mismos campos de
# identificador/contraseña) mas un campo de confirmacion -- se crea una
# cuenta nueva en usuarios.json (data_manager.py) y se entra directo a
# Inicio (registro + login combinados, igual que "El Happy Path para la
# Demo": Registro e Ingreso -> Creacion de Datos -> ...).
<RegisterScreen>:
    MeshBackground:
        MDAnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            GlassCard:
                orientation: 'vertical'
                size_hint: None, None
                width: dp(336)
                height: self.minimum_height
                radius: dp(28)
                md_bg_color: T.C_GLASS_MODAL
                shadow_strength: 2.6
                padding: dp(26), dp(28)
                spacing: dp(12)
                MDAnchorLayout:
                    anchor_x: 'center'
                    size_hint_y: None
                    height: dp(58)
                    GradientTile:
                        size_hint: None, None
                        size: dp(58), dp(58)
                        tile_radius: dp(18)
                        c1: T.C_PRIMARY
                        c2: T.C_PRIMARY_DARK
                        Icon:
                            name: 'permit'
                            color: 1, 1, 1, 1
                            size_hint: None, None
                            size: dp(26), dp(26)
                            pos_hint: {'center_x': .5, 'center_y': .5}
                Txt:
                    text: 'Crear cuenta'
                    font_size: sp(17)
                    bold: True
                    text_color: T.C_TEXT
                    halign: 'center'
                    text_size: self.width, None

                Txt:
                    text: 'RUT O CORREO'
                    font_size: sp(9.5)
                    bold: True
                    text_color: T.C_SECONDARY
                MDFloatLayout:
                    size_hint_y: None
                    height: dp(54)
                    MDBoxLayout:
                        pos_hint: {'x': 0, 'y': 0}
                        size_hint: 1, 1
                        md_bg_color: 1, 1, 1, .7
                        line_color: T.rgba(T.PRIMARY, 1) if identifier.valid else T.C_BG
                        line_width: 1.8
                        radius: dp(14)
                        padding: dp(6), dp(4)
                        MDFloatLayout:
                            TxtFijo:
                                text: 'RUT o correo'
                                font_name: T.FONT
                                font_size: sp(13)
                                text_color: T.rgba(T.SECONDARY, .55)
                                opacity: 0 if identifier.text else 1
                                halign: 'left'
                                valign: 'middle'
                                pos_hint: {'x': 0, 'y': 0}
                                size_hint: 1, 1
                                padding: dp(16), 0
                                text_size: self.width, None
                            LoginIdentifierInput:
                                id: identifier
                                pos_hint: {'x': 0, 'y': 0}
                                size_hint: 1, 1
                                mode: 'round'
                                line_color_normal: 0, 0, 0, 0
                                line_color_focus: 0, 0, 0, 0
                                fill_color_normal: 0, 0, 0, 0
                                fill_color_focus: 0, 0, 0, 0
                                foreground_color: T.C_TEXT
                                text_color_normal: T.C_TEXT
                                text_color_focus: T.C_TEXT
                                cursor_color: T.C_PRIMARY
                                font_name: T.FONT
                                font_size: sp(15)
                                multiline: False
                                halign: 'left'
                                padding: dp(16), dp(15)
                                on_id_valid: root.set_id_valid(args[1])

                Txt:
                    text: 'CONTRASEÑA'
                    font_size: sp(9.5)
                    bold: True
                    text_color: T.C_SECONDARY
                MDFloatLayout:
                    size_hint_y: None
                    height: dp(54)
                    MDBoxLayout:
                        pos_hint: {'x': 0, 'y': 0}
                        size_hint: 1, 1
                        md_bg_color: 1, 1, 1, .7
                        line_color: T.C_BG
                        line_width: 1.8
                        radius: dp(14)
                        padding: dp(6), dp(4)
                        PasswordInput:
                            id: password
                            pos_hint: {'x': 0, 'y': 0}
                            size_hint: 1, 1
                            password: True
                            password_mask: u'•'
                            mode: 'round'
                            line_color_normal: 0, 0, 0, 0
                            line_color_focus: 0, 0, 0, 0
                            fill_color_normal: 0, 0, 0, 0
                            fill_color_focus: 0, 0, 0, 0
                            foreground_color: T.C_TEXT
                            text_color_normal: T.C_TEXT
                            text_color_focus: T.C_TEXT
                            cursor_color: T.C_PRIMARY
                            font_name: T.FONT
                            font_size: sp(20)
                            multiline: False
                            halign: 'left'
                            padding: dp(16), dp(14)
                            on_text: root.set_password_filled(self.text)

                Txt:
                    text: 'CONFIRMAR CONTRASEÑA'
                    font_size: sp(9.5)
                    bold: True
                    text_color: T.C_SECONDARY
                MDFloatLayout:
                    size_hint_y: None
                    height: dp(54)
                    MDBoxLayout:
                        pos_hint: {'x': 0, 'y': 0}
                        size_hint: 1, 1
                        md_bg_color: 1, 1, 1, .7
                        line_color: T.C_BG
                        line_width: 1.8
                        radius: dp(14)
                        padding: dp(6), dp(4)
                        PasswordInput:
                            id: confirm
                            pos_hint: {'x': 0, 'y': 0}
                            size_hint: 1, 1
                            password: True
                            password_mask: u'•'
                            mode: 'round'
                            line_color_normal: 0, 0, 0, 0
                            line_color_focus: 0, 0, 0, 0
                            fill_color_normal: 0, 0, 0, 0
                            fill_color_focus: 0, 0, 0, 0
                            foreground_color: T.C_TEXT
                            text_color_normal: T.C_TEXT
                            text_color_focus: T.C_TEXT
                            cursor_color: T.C_PRIMARY
                            font_name: T.FONT
                            font_size: sp(20)
                            multiline: False
                            halign: 'left'
                            padding: dp(16), dp(14)
                            on_text: root.set_confirm_filled(self.text)

                Txt:
                    id: feedback
                    text: ''
                    font_size: sp(9.5)
                    bold: True
                    text_color: T.rgba(T.ORANGE, .95)
                    halign: 'center'
                    text_size: self.width, None
                    opacity: 1 if self.text else 0
                    height: self.texture_size[1] if self.text else 0

                SolidButton:
                    id: cta
                    text: 'Crear cuenta'
                    icon_name: 'check'
                    md_bg_color: T.C_PRIMARY
                    fg_color: 1, 1, 1, 1
                    height: dp(50)
                    radius: dp(17)
                    on_release: root.register()

                MDBoxLayout:
                    size_hint_y: None
                    height: dp(18)
                    spacing: dp(4)
                    MDWidget:
                    TxtFijo:
                        text: '¿Ya tienes cuenta?'
                        font_name: T.FONT
                        font_size: sp(10)
                        text_color: T.C_SECONDARY
                        adaptive_width: True
                    PressableBox:
                        size_hint: None, None
                        size: lbl_login.texture_size[0] + dp(4), dp(18)
                        on_release: app.go_to_login()
                        TxtFijo:
                            id: lbl_login
                            text: 'Inicia sesión'
                            font_name: T.FONT
                            font_size: sp(10)
                            bold: True
                            text_color: T.C_PRIMARY
                            adaptive_width: True
                            pos_hint: {'center_x': .5, 'center_y': .5}
                    MDWidget:


# ------------------------------------------------------------------- INICIO
# HomeScreen solo envuelve el RootScreen existente (el tablero con las
# tarjetas de resumen, acciones rapidas, pendientes y liquidaciones) dentro
# de una Screen real, para que el ScreenManager pueda navegar hacia/desde
# ella igual que hacia SignScreen y SuccessScreen.
<HomeScreen>:
    RootScreen:
        id: dashboard


# =================================================================== FIRMAR
# Efecto "modal flotante sobre fondo oscurecido" de la v1 (el que tenia el
# SignatureModal + ModalOverlay originales), reconstruido sobre una Screen
# real: InterfazRRHHApp.go_to_sign() toma una foto (export_as_image) del
# HomeScreen justo antes de navegar y la deja en 'bg_image'; el Color
# semitransparente se pinta encima (canvas.after de la imagen), y la
# tarjeta de firma queda centrada arriba de todo -- igual que el modal
# original, pero sin reintroducir el overlay que se crea/destruye cada vez
# que se abre (la causa de la fuga de memoria que se corrigio antes).
<SignScreen>:
    FloatLayout:
        SnapshotBackground:
            id: bg_image
            size_hint: 1, 1
            pos_hint: {'x': 0, 'y': 0}
        MDAnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            size_hint: 1, 1
            pos_hint: {'x': 0, 'y': 0}
            SignPanel:
                id: panel


# ========================================================= PANTALLA DE EXITO
<SuccessScreen>:
    FloatLayout:
        SnapshotBackground:
            id: bg_image
            size_hint: 1, 1
            pos_hint: {'x': 0, 'y': 0}
        MDAnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            size_hint: 1, 1
            pos_hint: {'x': 0, 'y': 0}
            GlassCard:
                orientation: 'vertical'
                size_hint: None, None
                width: dp(308)
                height: self.minimum_height
                radius: dp(26)
                md_bg_color: T.C_GLASS_MODAL
                shadow_strength: 2.6
                padding: dp(24), dp(26)
                spacing: dp(14)
                MDAnchorLayout:
                    anchor_x: 'center'
                    size_hint_y: None
                    height: dp(64)
                    MDFloatLayout:
                        size_hint: None, None
                        size: dp(64), dp(64)
                        Dot:
                            color: T.C_PRIMARY
                            pos_hint: {'x': 0, 'y': 0}
                            size_hint: 1, 1
                        Icon:
                            name: 'check'
                            color: 1, 1, 1, 1
                            size_hint: None, None
                            size: dp(32), dp(32)
                            pos_hint: {'center_x': .5, 'center_y': .5}
                Txt:
                    text: root.heading
                    font_size: sp(16)
                    bold: True
                    text_color: T.C_TEXT
                    halign: 'center'
                    text_size: self.width, None
                Txt:
                    text: root.message
                    font_size: sp(10.5)
                    text_color: T.C_SECONDARY
                    halign: 'center'
                    text_size: self.width, None
                SolidButton:
                    id: close_btn
                    text: 'Volver al inicio'
                    md_bg_color: T.C_PRIMARY
                    fg_color: 1, 1, 1, 1
                    height: dp(48)
                    radius: dp(16)
                    on_release: root.close()


# =================================================== AVISO DE NOTIFICACIONES
# Superposicion liviana (no es una Screen del ScreenManager) que abre el
# boton de campana de HeaderCard o el banner de Remote Config del
# Dashboard. Mismo "modal con fondo oscuro" que ModalOverlay en la v1,
# aqui reutilizado solo para esto.
<NotificationOverlay>:
    canvas.before:
        Color:
            rgba: T.rgba(T.TEXT, 0.4)
        Rectangle:
            pos: self.pos
            size: self.size
    GlassCard:
        id: card
        orientation: 'vertical'
        size_hint: None, None
        width: dp(312)
        height: self.minimum_height
        radius: dp(26)
        md_bg_color: T.C_GLASS_MODAL
        shadow_strength: 2.6
        padding: dp(24), dp(26)
        spacing: dp(14)
        pos_hint: {'center_x': .5, 'center_y': .5}
        MDAnchorLayout:
            anchor_x: 'center'
            size_hint_y: None
            height: dp(58)
            GradientTile:
                size_hint: None, None
                size: dp(58), dp(58)
                tile_radius: dp(19)
                c1: T.rgba(T.ORANGE)
                c2: T.rgba(T.ORANGE_DOT)
                Icon:
                    name: 'bell'
                    color: 1, 1, 1, 1
                    size_hint: None, None
                    size: dp(27), dp(27)
                    pos_hint: {'center_x': .5, 'center_y': .5}
        Txt:
            text: 'Notificaciones'
            font_size: sp(16)
            bold: True
            text_color: T.C_TEXT
            halign: 'center'
            text_size: self.width, None
        MDBoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            spacing: dp(8)
            Txt:
                text: 'No tienes notificaciones nuevas por ahora.'
                font_size: sp(13)
                text_color: T.C_SECONDARY
                halign: 'center'
                text_size: self.width, None
                opacity: 1 if (not root.message and not root.urgent_count and not root.item_count) else 0
                height: self.texture_size[1] if (not root.message and not root.urgent_count and not root.item_count) else 0
            Txt:
                text: root.message
                font_size: sp(13)
                bold: True
                text_color: T.C_TEXT
                halign: 'center'
                text_size: self.width, None
                opacity: 1 if root.message else 0
                height: self.texture_size[1] if root.message else 0
            MDBoxLayout:
                size_hint_y: None
                height: dp(26) if root.urgent_count else 0
                opacity: 1 if root.urgent_count else 0
                spacing: dp(6)
                padding: 0, dp(4)
                Icon:
                    name: 'file'
                    color: T.rgba(T.ORANGE)
                    size_hint: None, None
                    size: dp(15), dp(15)
                    pos_hint: {'center_y': .5}
                TxtFijo:
                    text: '%d documento(s) urgente(s) por firmar' % root.urgent_count
                    font_name: T.FONT
                    font_size: sp(10.5)
                    bold: True
                    text_color: T.rgba(T.ORANGE)
                    adaptive_width: True
        MDScrollView:
            size_hint_y: None
            height: min(notif_list.height, dp(236)) if root.item_count else 0
            opacity: 1 if root.item_count else 0
            bar_width: dp(3)
            scroll_type: ['bars', 'content']
            bar_color: T.rgba(T.PRIMARY, .25)
            bar_inactive_color: 0, 0, 0, 0
            MDBoxLayout:
                id: notif_list
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(8)
        SolidButton:
            text: 'Cerrar'
            md_bg_color: T.C_PRIMARY
            fg_color: 1, 1, 1, 1
            height: dp(46)
            radius: dp(15)
            on_release: root.close()


# =================================================================== RAIZ
<RootScreen>:
    MDScrollView:
        bar_width: dp(3)
        scroll_type: ['bars', 'content']
        bar_color: T.rgba(T.PRIMARY, .25)
        bar_inactive_color: 0, 0, 0, 0
        MDBoxLayout:
            id: col
            orientation: 'vertical'
            size_hint_y: None
            height: self.minimum_height
            padding: dp(16), dp(28), dp(16), dp(104)
            spacing: dp(14)

            HeaderCard:
                has_alerts: bool(root.banner_text) or app.notif_count > 0

            # Banner de Remote Config: vacio por defecto (Default Local, ver
            # RootScreen.banner_text en main.py). Si InterfazRRHHApp logra
            # traer el JSON remoto, 'banner_message' llena este texto y la
            # fila aparece sola -- sin que nadie la programe a mano, porque
            # 'height'/'opacity' ya dependen de 'root.banner_text' aqui.
            PressableBox:
                id: remote_banner
                size_hint_y: None
                height: dp(46) if root.banner_text else 0
                opacity: 1 if root.banner_text else 0
                padding: dp(14), 0
                spacing: dp(10)
                radius: dp(14)
                md_bg_color: T.rgba(T.ORANGE_BG)
                line_color: T.rgba(T.ORANGE, .5)
                line_width: 1.3
                disabled: not root.banner_text
                on_release: app.show_notifications()
                MDFloatLayout:
                    size_hint: None, None
                    size: dp(26), dp(26)
                    GradientTile:
                        size_hint: 1, 1
                        tile_radius: dp(9)
                        c1: T.rgba(T.ORANGE)
                        c2: T.rgba(T.ORANGE_DOT)
                        Icon:
                            name: 'bell'
                            color: 1, 1, 1, 1
                            size_hint: None, None
                            size: dp(14), dp(14)
                            pos_hint: {'center_x': .5, 'center_y': .5}
                TxtFijo:
                    text: root.banner_text
                    font_name: T.FONT
                    font_size: sp(11.5)
                    bold: True
                    text_color: T.rgba(T.PRIMARY_DARK)
                    halign: 'left'
                    text_size: self.width, None
                    size_hint_x: 1
                Icon:
                    name: 'chevron'
                    color: T.rgba(T.ORANGE)
                    size_hint: None, None
                    size: dp(14), dp(14)
                    pos_hint: {'center_y': .5}
                    opacity: 1 if root.banner_text else 0

            MDGridLayout:
                cols: 3
                spacing: dp(10)
                size_hint_y: None
                height: dp(64)
                StatCard:
                    value: '18'
                    sub: 'Sep 2026'
                StatCard:
                    value: str(root.vacation_days)
                    sub: 'días libres'
                StatCard:
                    value: str(root.pending_count)
                    sub: 'sin firma'

            SectionLabel:
                title: 'ACCIONES RÁPIDAS'

            MDGridLayout:
                cols: 3
                spacing: dp(10)
                size_hint_y: None
                height: dp(148)
                QuickActionCard:
                    icon_name: 'vacation'
                    label_text: 'Pedir Vacaciones'
                    sub_text: 'Solicita días libres'
                    c1: T.C_PRIMARY
                    c2: T.C_PRIMARY_DARK
                    on_release: app.go_to_vacations()
                QuickActionCard:
                    icon_name: 'permit'
                    label_text: 'Solicitar Permiso'
                    sub_text: 'Permiso administrativo'
                    c1: T.C_PRIMARY_LIGHT
                    c2: T.C_PRIMARY
                    on_release: app.go_to_permit()
                QuickActionCard:
                    icon_name: 'camera'
                    label_text: 'Subir Licencia'
                    sub_text: 'Foto o PDF médico'
                    c1: T.C_SECONDARY
                    c2: T.C_PRIMARY_LIGHT
                    on_release: app.go_to_license()

            SectionLabel:
                title: 'TAREAS PENDIENTES'
                count: root.pending_count

            MDBoxLayout:
                id: pending_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                spacing: dp(14)
                # PendingCard x2 se agregan desde Python (son datos, no diseno)

            SectionLabel:
                title: 'LIQUIDACIONES RECIENTES'

            GlassCard:
                id: docs_card
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                radius: dp(22)
                padding: dp(16), dp(6)
                MDBoxLayout:
                    size_hint_y: None
                    height: dp(38)
                    spacing: dp(6)
                    MDBoxLayout:
                        spacing: dp(5)
                        Icon:
                            name: 'check'
                            color: T.rgba(T.EMERALD)
                            size_hint: None, None
                            size: dp(13), dp(13)
                            pos_hint: {'center_y': .5}
                        Txt:
                            text: 'Disponibles sin conexión'
                            font_size: sp(9.5)
                            text_color: T.rgba(T.EMERALD)
                            size_hint_x: None
                            width: dp(140)
                        MDWidget:
                    MDBoxLayout:
                        spacing: dp(5)
                        MDWidget:
                        Icon:
                            name: 'pin'
                            color: T.C_SECONDARY
                            size_hint: None, None
                            size: dp(13), dp(13)
                            pos_hint: {'center_y': .5}
                        Txt:
                            text: 'Fijados al dispositivo'
                            font_size: sp(9.5)
                            text_color: T.C_SECONDARY
                            size_hint_x: None
                            width: dp(112)
                Divider:
                    size_hint_y: None
                    height: dp(1)
                MDBoxLayout:
                    id: docs_box
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    # DocRow x4 se agregan desde Python (son datos, no diseno)

            MDBoxLayout:
                id: extra_box
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                # DesktopCtaCard opcional (SHOW_DESKTOP_CTA), agregado desde Python

    FooterCard:
        id: footer
        size_hint: 1, None
        height: dp(64)
        pos_hint: {'x': 0, 'y': 0}


# ================================================== SOLICITUDES: COMPONENTES
# Vacaciones, Permiso y Licencia comparten estas piezas (misma paleta, mismas
# tarjetas "glass"). Las 3 pantallas de abajo solo las ordenan.

<ScreenHeader>:
    size_hint_y: None
    height: dp(84)
    padding: dp(16), dp(24), dp(16), dp(8)
    spacing: dp(12)
    IconButton:
        icon_name: 'back'
        icon_color: T.C_PRIMARY
        md_bg_color: T.C_TINT_10
        radius: dp(13)
        size_hint: None, None
        size: dp(40), dp(40)
        pos_hint: {'center_y': .5}
        on_release: app.go_home()
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(2)
        MDWidget:
        Txt:
            text: root.title
            font_size: sp(18)
            bold: True
            text_color: T.C_TEXT
        Txt:
            text: root.subtitle
            font_size: sp(10.5)
            text_color: T.C_SECONDARY
        MDWidget:


<Chip>:
    size_hint: None, None
    height: dp(32)
    width: chip_lbl.texture_size[0] + dp(26)
    padding: dp(13), 0
    radius: dp(16)
    md_bg_color: T.C_TINT_10
    line_color: T.rgba(T.PRIMARY, .35)
    line_width: 1.2
    TxtFijo:
        id: chip_lbl
        text: root.text
        font_name: T.FONT
        font_size: sp(11)
        bold: True
        text_color: T.C_PRIMARY_DARK
        adaptive_width: True


# Un dia del calendario: el color depende de 'state' (ver DayCell en widgets.py).
<DayCell>:
    radius: dp(12)
    md_bg_color: T.C_PRIMARY if root.state == 'edge' else (T.C_TINT_20 if root.state == 'range' else (0, 0, 0, 0))
    line_color: T.C_PRIMARY if root.state == 'today' else (0, 0, 0, 0)
    line_width: 1.5
    disabled: root.state in ('empty', 'disabled')
    TxtFijo:
        text: root.text
        font_name: T.FONT
        font_size: sp(13)
        bold: root.state in ('edge', 'today')
        text_color: (1, 1, 1, 1) if root.state == 'edge' else (T.C_PRIMARY_DARK if root.state == 'range' else (T.rgba(T.SECONDARY, .55) if root.state == 'disabled' else T.C_TEXT))
        disabled_color: self.text_color


<CalendarPicker>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(8)
    MDBoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(8)
        IconButton:
            icon_name: 'back'
            icon_color: T.C_PRIMARY if root.can_prev else T.rgba(T.SECONDARY, .4)
            md_bg_color: T.C_TINT_10 if root.can_prev else (0, 0, 0, 0)
            radius: dp(12)
            size_hint: None, None
            size: dp(38), dp(38)
            pos_hint: {'center_y': .5}
            on_release: root.prev_month()
        TxtFijo:
            text: root.month_label
            font_name: T.FONT
            font_size: sp(14.5)
            bold: True
            text_color: T.C_TEXT
        IconButton:
            icon_name: 'chevron'
            icon_color: T.C_PRIMARY
            md_bg_color: T.C_TINT_10
            radius: dp(12)
            size_hint: None, None
            size: dp(38), dp(38)
            pos_hint: {'center_y': .5}
            on_release: root.next_month()
    MDGridLayout:
        cols: 7
        size_hint_y: None
        height: dp(18)
        TxtFijo:
            text: 'L'
            font_name: T.FONT
            font_size: sp(10)
            bold: True
            text_color: T.C_SECONDARY
        TxtFijo:
            text: 'M'
            font_name: T.FONT
            font_size: sp(10)
            bold: True
            text_color: T.C_SECONDARY
        TxtFijo:
            text: 'M'
            font_name: T.FONT
            font_size: sp(10)
            bold: True
            text_color: T.C_SECONDARY
        TxtFijo:
            text: 'J'
            font_name: T.FONT
            font_size: sp(10)
            bold: True
            text_color: T.C_SECONDARY
        TxtFijo:
            text: 'V'
            font_name: T.FONT
            font_size: sp(10)
            bold: True
            text_color: T.C_SECONDARY
        TxtFijo:
            text: 'S'
            font_name: T.FONT
            font_size: sp(10)
            bold: True
            text_color: T.C_SECONDARY
        TxtFijo:
            text: 'D'
            font_name: T.FONT
            font_size: sp(10)
            bold: True
            text_color: T.C_SECONDARY
    MDGridLayout:
        id: grid
        cols: 7
        rows: 6
        size_hint_y: None
        height: dp(6 * 42)
        spacing: dp(3)
        # 42 DayCell se agregan desde Python (CalendarPicker.on_kv_post)
    MDBoxLayout:
        size_hint_y: None
        height: dp(40)
        padding: dp(12), 0
        spacing: dp(8)
        radius: dp(12)
        md_bg_color: T.C_TINT_10 if root.complete else T.rgba(T.MUTED, .9)
        Icon:
            name: 'calendar'
            color: T.C_PRIMARY if root.complete else T.C_SECONDARY
            size_hint: None, None
            size: dp(16), dp(16)
            pos_hint: {'center_y': .5}
        TxtFijo:
            text: root.summary
            font_name: T.FONT
            font_size: sp(11)
            bold: root.complete
            text_color: T.C_PRIMARY_DARK if root.complete else T.C_SECONDARY
            halign: 'left'
            text_size: self.size


<ReasonCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    radius: dp(22)
    padding: dp(16)
    spacing: dp(10)
    MDBoxLayout:
        size_hint_y: None
        height: dp(18)
        TxtFijo:
            text: root.title
            font_name: T.FONT
            font_size: sp(11.5)
            bold: True
            text_color: T.C_TEXT
            adaptive_width: True
        MDWidget:
        TxtFijo:
            text: '%d/%d' % (len(root.text), root.max_chars)
            font_name: T.FONT
            font_size: sp(9.5)
            text_color: T.C_SECONDARY
            adaptive_width: True
    MDBoxLayout:
        size_hint_y: None
        height: dp(118)
        md_bg_color: 1, 1, 1, .7
        line_color: T.C_PRIMARY if field.focus else T.C_BG
        line_width: 1.8
        radius: dp(14)
        padding: dp(8), dp(6)
        ReasonInput:
            id: field
            hint_text: root.placeholder
            hint_text_color: T.rgba(T.SECONDARY, .65)
            background_normal: ''
            background_active: ''
            background_color: 0, 0, 0, 0
            foreground_color: T.C_TEXT
            cursor_color: T.C_PRIMARY
            selection_color: T.rgba(T.PRIMARY, .25)
            font_name: T.FONT
            font_size: sp(13.5)
            padding: dp(8), dp(8)
            max_chars: root.max_chars
            on_text: root.text = self.text


<OptionRow>:
    size_hint_y: None
    height: dp(46)
    padding: dp(14), 0
    spacing: dp(8)
    radius: dp(12)
    md_bg_color: T.C_TINT_10 if root.selected else (0, 0, 0, 0)
    TxtFijo:
        text: root.text
        font_name: T.FONT
        font_size: sp(12)
        bold: root.selected
        text_color: T.C_PRIMARY_DARK if root.selected else T.C_TEXT
        halign: 'left'
        text_size: self.size
    Icon:
        name: 'check'
        color: T.C_PRIMARY
        opacity: 1 if root.selected else 0
        size_hint: None, None
        size: dp(14), dp(14)
        pos_hint: {'center_y': .5}


<DropdownField>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: dp(6)
    PressableBox:
        size_hint_y: None
        height: dp(56)
        padding: dp(16), 0
        spacing: dp(8)
        radius: dp(14)
        md_bg_color: 1, 1, 1, .7
        line_color: T.C_PRIMARY if (root.expanded or root.selected) else T.C_BG
        line_width: 1.8
        on_release: root.toggle()
        TxtFijo:
            text: root.selected if root.selected else root.placeholder
            font_name: T.FONT
            font_size: sp(13)
            bold: bool(root.selected)
            text_color: T.C_TEXT if root.selected else T.rgba(T.SECONDARY, .85)
            halign: 'left'
            text_size: self.size
        Icon:
            name: 'down'
            color: T.C_PRIMARY
            size_hint: None, None
            size: dp(18), dp(18)
            pos_hint: {'center_y': .5}
    MDBoxLayout:
        id: options_box
        orientation: 'vertical'
        size_hint_y: None
        height: (self.minimum_height) if root.expanded else 0
        opacity: 1 if root.expanded else 0
        disabled: not root.expanded
        padding: dp(6)
        spacing: dp(2)
        radius: dp(14)
        md_bg_color: 1, 1, 1, .85
        line_color: T.C_BG
        line_width: 1.2


<SourceTile>:
    orientation: 'vertical'
    radius: dp(18)
    padding: dp(12)
    spacing: dp(6)
    md_bg_color: T.C_TINT_10 if root.active else (1, 1, 1, .7)
    line_color: T.C_PRIMARY if root.active else T.C_BG
    line_width: 1.8
    MDFloatLayout:
        size_hint: None, None
        size: dp(38), dp(38)
        GradientTile:
            pos_hint: {'x': 0, 'y': 0}
            size_hint: 1, 1
            tile_radius: dp(13)
            c1: T.C_PRIMARY
            c2: T.C_PRIMARY_DARK
        Icon:
            name: root.icon_name
            color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(20), dp(20)
            pos_hint: {'center_x': .5, 'center_y': .5}
    Txt:
        text: root.title
        font_size: sp(12)
        bold: True
        text_color: T.C_TEXT
    Txt:
        text: root.subtitle
        font_size: sp(9.5)
        text_color: T.C_SECONDARY
    MDWidget:


<RequestRow>:
    orientation: 'vertical'
    size_hint_y: None
    height: dp(64)
    MDBoxLayout:
        spacing: dp(10)
        padding: 0, dp(8)
        IconTile:
            size_hint: None, None
            size: dp(38), dp(38)
            pos_hint: {'center_y': .5}
            icon_name: root.icon_name
            icon_color: T.C_PRIMARY
            md_bg_color: T.C_BG
            radius: dp(13)
        MDBoxLayout:
            orientation: 'vertical'
            spacing: dp(2)
            MDWidget:
            Txt:
                text: root.title
                font_size: sp(12)
                bold: True
                text_color: T.C_TEXT
                shorten: True
                shorten_from: 'right'
                height: dp(16)
            Txt:
                text: root.detail
                font_size: sp(10)
                text_color: T.C_SECONDARY
                shorten: True
                shorten_from: 'right'
                height: dp(14)
            MDWidget:
        Pill:
            text: 'Aprobada' if root.status == 'aprobada' else 'Pendiente'
            fg_color: T.rgba(T.EMERALD) if root.status == 'aprobada' else T.rgba(T.ORANGE)
            md_bg_color: T.rgba(T.EMERALD_BG) if root.status == 'aprobada' else T.rgba(T.ORANGE_BG)
            pos_hint: {'center_y': .5}
    Divider:
        size_hint_y: None
        height: dp(1)
        opacity: 0 if root.last else 1


<NotificationRow>:
    size_hint_y: None
    height: dp(60)
    padding: dp(10), 0
    spacing: dp(10)
    radius: dp(14)
    md_bg_color: T.C_TINT_10
    line_color: T.rgba(T.PRIMARY, .3)
    line_width: 1.2
    on_release: app.open_notification(root.notif_id)
    MDFloatLayout:
        size_hint: None, None
        size: dp(36), dp(36)
        pos_hint: {'center_y': .5}
        GradientTile:
            pos_hint: {'x': 0, 'y': 0}
            size_hint: 1, 1
            tile_radius: dp(12)
            c1: T.C_PRIMARY
            c2: T.C_PRIMARY_DARK
        Icon:
            name: root.icon_name
            color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(18), dp(18)
            pos_hint: {'center_x': .5, 'center_y': .5}
    Txt:
        text: root.text
        font_size: sp(11.5)
        bold: True
        text_color: T.C_PRIMARY_DARK
        pos_hint: {'center_y': .5}
    Icon:
        name: 'chevron'
        color: T.C_PRIMARY
        size_hint: None, None
        size: dp(14), dp(14)
        pos_hint: {'center_y': .5}


# Aviso emergente que aparece arriba de cualquier pantalla cuando RR.HH.
# responde una solicitud; al tocarlo abre la seccion y se quita.
<NotificationToast>:
    orientation: 'horizontal'
    size_hint: None, None
    size: dp(392), dp(66)
    pos_hint: {'center_x': .5, 'top': .985}
    opacity: 0
    radius: dp(20)
    padding: dp(12), 0
    spacing: dp(12)
    md_bg_color: 1, 1, 1, .98
    line_color: T.rgba(T.ORANGE, .55)
    line_width: 1.5
    shadow_strength: 2.6
    on_release: app.open_notification(root.notif_id)
    MDFloatLayout:
        size_hint: None, None
        size: dp(40), dp(40)
        pos_hint: {'center_y': .5}
        GradientTile:
            pos_hint: {'x': 0, 'y': 0}
            size_hint: 1, 1
            tile_radius: dp(13)
            c1: T.rgba(T.ORANGE)
            c2: T.rgba(T.ORANGE_DOT)
        Icon:
            name: root.icon_name
            color: 1, 1, 1, 1
            size_hint: None, None
            size: dp(20), dp(20)
            pos_hint: {'center_x': .5, 'center_y': .5}
    MDBoxLayout:
        orientation: 'vertical'
        spacing: dp(2)
        MDWidget:
        Txt:
            text: 'RR.HH. RESPONDIÓ · TOCA PARA ABRIR'
            font_size: sp(8.5)
            bold: True
            text_color: T.rgba(T.ORANGE)
        Txt:
            text: root.text
            font_size: sp(12)
            bold: True
            text_color: T.C_PRIMARY_DARK
        MDWidget:
    Icon:
        name: 'chevron'
        color: T.rgba(T.ORANGE)
        size_hint: None, None
        size: dp(14), dp(14)
        pos_hint: {'center_y': .5}


<FilePickerPopup>:
    size_hint: .94, .78
    background: ''
    background_color: 0, 0, 0, 0
    overlay_color: T.rgba(T.TEXT, .45)
    GlassCard:
        orientation: 'vertical'
        radius: dp(22)
        md_bg_color: T.C_GLASS_MODAL
        padding: dp(14)
        spacing: dp(10)
        Txt:
            text: 'Elige el archivo de tu licencia'
            font_size: sp(14)
            bold: True
            text_color: T.C_TEXT
        MDBoxLayout:
            # El selector de Kivy trae texto blanco: va sobre un fondo oscuro
            # de la paleta para que se lea.
            md_bg_color: T.C_PRIMARY_DARK
            radius: dp(14)
            padding: dp(6)
            FileChooserListView:
                id: chooser
                on_submit: root.choose()
        MDBoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(10)
            SolidButton:
                text: 'Cancelar'
                md_bg_color: T.C_TINT_10
                fg_color: T.C_PRIMARY
                radius: dp(15)
                on_release: root.dismiss()
            SolidButton:
                text: 'Elegir'
                md_bg_color: T.C_PRIMARY
                fg_color: 1, 1, 1, 1
                radius: dp(15)
                on_release: root.choose()


# ============================================================ PANTALLAS
# Cada una: cabecera (volver) + contenido con scroll + boton fijo abajo.
<VacationScreen>:
    MeshBackground:
        MDBoxLayout:
            orientation: 'vertical'
            ScreenHeader:
                title: 'Pedir Vacaciones'
                subtitle: 'Elige el período de tu descanso'
            MDScrollView:
                bar_width: dp(3)
                scroll_type: ['bars', 'content']
                bar_color: T.rgba(T.PRIMARY, .25)
                bar_inactive_color: 0, 0, 0, 0
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16), dp(6), dp(16), dp(18)
                    spacing: dp(14)
                    GlassCard:
                        size_hint_y: None
                        height: dp(60)
                        radius: dp(18)
                        padding: dp(14), 0
                        spacing: dp(12)
                        IconTile:
                            size_hint: None, None
                            size: dp(36), dp(36)
                            pos_hint: {'center_y': .5}
                            icon_name: 'vacation'
                            icon_color: T.C_PRIMARY
                            md_bg_color: T.C_TINT_10
                            radius: dp(12)
                        MDBoxLayout:
                            orientation: 'vertical'
                            MDWidget:
                            Txt:
                                text: 'Días disponibles'
                                font_size: sp(10)
                                text_color: T.C_SECONDARY
                            Txt:
                                text: S.plural_days(int(root.available))
                                font_size: sp(15)
                                bold: True
                                text_color: T.C_PRIMARY
                            MDWidget:
                    SectionLabel:
                        title: 'ELIGE LAS FECHAS'
                    GlassCard:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        radius: dp(22)
                        padding: dp(14)
                        CalendarPicker:
                            id: calendar
                            on_range_change: root.refresh()
                    Txt:
                        text: root.error
                        font_size: sp(10)
                        bold: True
                        text_color: T.rgba(T.ORANGE, .95)
                        opacity: 1 if root.error else 0
                        height: self.texture_size[1] if root.error else 0
                    ReasonCard:
                        id: reason
                        title: 'Motivo de tus vacaciones'
                        placeholder: 'Cuéntanos brevemente por qué pides estos días…'
                        on_text: root.refresh()
                    SectionLabel:
                        title: 'TUS SOLICITUDES'
                    GlassCard:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        radius: dp(22)
                        padding: dp(16), dp(8)
                        Txt:
                            text: 'Aún no has enviado solicitudes de vacaciones.'
                            font_size: sp(10.5)
                            text_color: T.C_SECONDARY
                            padding: 0, dp(8)
                            opacity: 0 if root.has_requests else 1
                            height: 0 if root.has_requests else self.texture_size[1] + dp(16)
                        MDBoxLayout:
                            id: requests_box
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
            MDBoxLayout:
                size_hint_y: None
                height: dp(78)
                padding: dp(16), dp(12)
                md_bg_color: 1, 1, 1, .72
                SolidButton:
                    id: cta
                    text: 'Enviar solicitud'
                    icon_name: 'chevron'
                    md_bg_color: T.C_PRIMARY
                    fg_color: 1, 1, 1, 1
                    height: dp(52)
                    radius: dp(17)
                    on_release: root.send()


<PermitScreen>:
    MeshBackground:
        MDBoxLayout:
            orientation: 'vertical'
            ScreenHeader:
                title: 'Solicitar Permiso'
                subtitle: 'Un día libre por fuerza mayor'
            MDScrollView:
                bar_width: dp(3)
                scroll_type: ['bars', 'content']
                bar_color: T.rgba(T.PRIMARY, .25)
                bar_inactive_color: 0, 0, 0, 0
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16), dp(6), dp(16), dp(18)
                    spacing: dp(14)
                    MDBoxLayout:
                        size_hint_y: None
                        height: self.minimum_height
                        padding: dp(14), dp(12)
                        spacing: dp(10)
                        radius: dp(16)
                        md_bg_color: T.rgba(T.ORANGE_BG)
                        line_color: T.rgba(T.ORANGE, .45)
                        line_width: 1.2
                        Icon:
                            name: 'permit'
                            color: T.rgba(T.ORANGE)
                            size_hint: None, None
                            size: dp(20), dp(20)
                            pos_hint: {'top': 1}
                        Txt:
                            text: 'Solo para emergencias o fuerza mayor (salud, familia, siniestros). Son de 1 a 3 días; para un descanso planificado usa Pedir Vacaciones.'
                            font_size: sp(10.5)
                            text_color: T.C_PRIMARY_DARK
                    SectionLabel:
                        title: 'ELIGE EL DÍA (MÁXIMO 3)'
                    GlassCard:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        radius: dp(22)
                        padding: dp(14)
                        CalendarPicker:
                            id: calendar
                            on_range_change: root.refresh()
                    Txt:
                        text: root.error
                        font_size: sp(10)
                        bold: True
                        text_color: T.rgba(T.ORANGE, .95)
                        opacity: 1 if root.error else 0
                        height: self.texture_size[1] if root.error else 0
                    SectionLabel:
                        title: 'MOTIVOS FRECUENTES'
                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(32)
                        spacing: dp(8)
                        Chip:
                            text: 'Emergencia familiar'
                            on_release: root.use_reason('Emergencia familiar')
                        Chip:
                            text: 'Salud'
                            on_release: root.use_reason('Problema de salud')
                        Chip:
                            text: 'Siniestro'
                            on_release: root.use_reason('Siniestro en mi domicilio')
                        MDWidget:
                    ReasonCard:
                        id: reason
                        title: 'Motivo de fuerza mayor'
                        placeholder: 'Explica qué ocurrió y por qué necesitas ausentarte…'
                        on_text: root.refresh()
                    SectionLabel:
                        title: 'TUS SOLICITUDES'
                    GlassCard:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        radius: dp(22)
                        padding: dp(16), dp(8)
                        Txt:
                            text: 'Aún no has enviado solicitudes de permiso.'
                            font_size: sp(10.5)
                            text_color: T.C_SECONDARY
                            opacity: 0 if root.has_requests else 1
                            height: 0 if root.has_requests else self.texture_size[1] + dp(16)
                        MDBoxLayout:
                            id: requests_box
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
            MDBoxLayout:
                size_hint_y: None
                height: dp(78)
                padding: dp(16), dp(12)
                md_bg_color: 1, 1, 1, .72
                SolidButton:
                    id: cta
                    text: 'Enviar solicitud'
                    icon_name: 'chevron'
                    md_bg_color: T.C_PRIMARY
                    fg_color: 1, 1, 1, 1
                    height: dp(52)
                    radius: dp(17)
                    on_release: root.send()


<LicenseScreen>:
    MeshBackground:
        MDBoxLayout:
            orientation: 'vertical'
            ScreenHeader:
                title: 'Subir Licencia'
                subtitle: 'Adjunta tu licencia médica'
            MDScrollView:
                bar_width: dp(3)
                scroll_type: ['bars', 'content']
                bar_color: T.rgba(T.PRIMARY, .25)
                bar_inactive_color: 0, 0, 0, 0
                MDBoxLayout:
                    orientation: 'vertical'
                    size_hint_y: None
                    height: self.minimum_height
                    padding: dp(16), dp(6), dp(16), dp(18)
                    spacing: dp(14)
                    SectionLabel:
                        title: 'TIPO DE LICENCIA'
                    DropdownField:
                        id: type_select
                        placeholder: 'Selecciona el tipo de licencia'
                        options: S.LICENSE_TYPES
                        on_select: root.refresh()
                    SectionLabel:
                        title: 'ADJUNTA TU LICENCIA'
                    MDBoxLayout:
                        size_hint_y: None
                        height: dp(116)
                        spacing: dp(12)
                        SourceTile:
                            icon_name: 'upload'
                            title: 'Subir archivo'
                            subtitle: 'PDF, PNG o JPG'
                            active: root.source == 'file'
                            on_release: root.pick_file()
                        SourceTile:
                            icon_name: 'camera'
                            title: 'Tomar foto'
                            subtitle: 'Con la cámara'
                            active: root.source == 'camera'
                            on_release: root.take_photo()
                    Txt:
                        text: root.notice
                        font_size: sp(10)
                        bold: True
                        text_color: T.rgba(T.ORANGE, .95)
                        opacity: 1 if root.notice else 0
                        height: self.texture_size[1] if root.notice else 0
                    GlassCard:
                        size_hint_y: None
                        height: dp(76) if root.file_name else 0
                        opacity: 1 if root.file_name else 0
                        disabled: not root.file_name
                        radius: dp(18)
                        padding: dp(12), dp(10)
                        spacing: dp(12)
                        line_color: (T.rgba(T.EMERALD, .6) if root.file_ok else T.rgba(T.ORANGE, .7)) if root.file_name else T.C_GLASS_BORDER
                        line_width: 1.4
                        MDFloatLayout:
                            size_hint: None, None
                            size: dp(54), dp(54)
                            pos_hint: {'center_y': .5}
                            IconTile:
                                pos_hint: {'x': 0, 'y': 0}
                                size_hint: 1, 1
                                icon_name: 'file'
                                icon_color: T.C_PRIMARY
                                md_bg_color: T.C_BG
                                radius: dp(14)
                            Image:
                                source: root.file_path if root.file_is_image else ''
                                fit_mode: 'cover'
                                pos_hint: {'x': 0, 'y': 0}
                                size_hint: 1, 1
                                opacity: 1 if root.file_is_image else 0
                        MDBoxLayout:
                            orientation: 'vertical'
                            spacing: dp(3)
                            MDWidget:
                            Txt:
                                text: root.file_name
                                font_size: sp(12)
                                bold: True
                                text_color: T.C_TEXT
                                shorten: True
                                shorten_from: 'right'
                                height: dp(16)
                            Txt:
                                text: root.file_msg
                                font_size: sp(9.5)
                                bold: True
                                text_color: T.rgba(T.EMERALD) if root.file_ok else T.rgba(T.ORANGE)
                            MDWidget:
                        IconButton:
                            icon_name: 'close'
                            icon_color: T.C_SECONDARY
                            md_bg_color: T.C_TINT_10
                            radius: dp(12)
                            size_hint: None, None
                            size: dp(34), dp(34)
                            pos_hint: {'center_y': .5}
                            on_release: root.remove_file()
                    SectionLabel:
                        title: 'TUS SOLICITUDES'
                    GlassCard:
                        orientation: 'vertical'
                        size_hint_y: None
                        height: self.minimum_height
                        radius: dp(22)
                        padding: dp(16), dp(8)
                        Txt:
                            text: 'Aún no has subido licencias.'
                            font_size: sp(10.5)
                            text_color: T.C_SECONDARY
                            opacity: 0 if root.has_requests else 1
                            height: 0 if root.has_requests else self.texture_size[1] + dp(16)
                        MDBoxLayout:
                            id: requests_box
                            orientation: 'vertical'
                            size_hint_y: None
                            height: self.minimum_height
            MDBoxLayout:
                size_hint_y: None
                height: dp(78)
                padding: dp(16), dp(12)
                md_bg_color: 1, 1, 1, .72
                SolidButton:
                    id: cta
                    text: 'Enviar licencia'
                    icon_name: 'chevron'
                    md_bg_color: T.C_PRIMARY
                    fg_color: 1, 1, 1, 1
                    height: dp(52)
                    radius: dp(17)
                    on_release: root.send()
